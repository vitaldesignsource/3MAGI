# Three Magi Press — Apache/LiteSpeed rules for Hostinger shared hosting.
# Vite copies this file into the build output alongside index.html.

# --- Single-page app routing ---------------------------------------------
# React Router owns the URL space (/books, /third-lamp/archive, /articles/…).
# Any request that isn't a real file or directory is handed to index.html so
# deep links and hard refreshes work. Real assets are served as-is.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching ----------------------------------------------------------------
# Vite fingerprints everything under /assets/ (index-XXXX.js), so those are
# safe to cache forever. /media/ and /fonts/ keep human-readable names that
# may be replaced in place, so they get a week. index.html must never be
# cached, or visitors keep an old build that points at assets that no longer
# exist after a deploy.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/(media|fonts)/#">
    Header set Cache-Control "public, max-age=604800"
  </If>
  <FilesMatch "^(index\.html|sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Compression --------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Correct MIME types for web fonts -----------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff  .woff
  AddType image/webp .webp
</IfModule>
